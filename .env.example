# Copy this file to .env. Never commit the populated .env file.
# Generate secrets with: openssl rand -base64 32
MYSQL_DATABASE=leadflow
MYSQL_USER=leadflow
MYSQL_PASSWORD=replace_with_a_long_unique_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_root_password

# Created once on an empty production database. Use a unique 12+ character password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
AUTH_TOKEN_TTL_HOURS=24

# Port 80 is used by default. Change only when a reverse proxy owns port 80.
HTTP_PORT=80

# A persistent browser profile. Keep it private and outside version control.
PLAYWRIGHT_PROFILE_DIRECTORY=./playwright-profile
# Browser tabs processing requests at the same time. Keep at 1 unless you have tested a higher limit.
FACEBOOK_MAX_CONCURRENT_TABS=1
