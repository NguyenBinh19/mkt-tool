# Backend database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/leadflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=leadflow
DB_PASSWORD=leadflow_secret

# Set true on a Linux server without a graphical desktop. For manual Facebook login, use false.
FACEBOOK_HEADLESS=false
FACEBOOK_PROFILE_DIRECTORY=../playwright-profile

# Frontend Vite proxy target
VITE_API_URL=http://localhost:8080
